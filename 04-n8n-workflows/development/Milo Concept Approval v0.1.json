      "name": "Filter Unprocessed Approved Concepts"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst groups = {};\n\nfor (const item of items) {\n  const storyId = item.json.storyId ?? '';\n\n  if (!groups[storyId]) {\n    groups[storyId] = [];\n  }\n\n  groups[storyId].push(item.json);\n}\n\nconst output = [];\n\nfor (const [storyId, concepts] of Object.entries(groups)) {\n\n  if (!storyId) {\n    output.push({\n      json: {\n        success: false,\n        valid: false,\n        errorCode: 'STORY_ID_MISSING',\n        message: 'Approved concept is missing storyId.',\n        storyId: ''\n      }\n    });\n    continue;\n  }\n\n  if (concepts.length !== 1) {\n    output.push({\n      json: {\n        success: false,\n        valid: false,\n        errorCode: 'APPROVED_CONCEPT_COUNT_INVALID',\n        message: 'Story must have exactly one unprocessed APPROVED concept.',\n        storyId,\n        approvedConceptCount: concepts.length\n      }\n    });\n    continue;\n  }\n\n  const concept = concepts[0];\n\n  const conceptIdValid =\n    /^MILO-[0-9]{3}-C0[1-3]$/.test(concept.conceptId ?? '') &&\n    concept.conceptId.startsWith(`${storyId}-C0`);\n\n  if (!conceptIdValid) {\n    output.push({\n      json: {\n        success: false,\n        valid: false,\n        errorCode: 'CONCEPT_STORY_ID_MISMATCH',\n        message: 'conceptId is invalid or does not belong to storyId.',\n        storyId,\n        conceptId: concept.conceptId ?? ''\n      }\n    });\n    continue;\n  }\n\n  output.push({\n    json: {\n      ...concept,\n      success: true,\n      valid: true\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
