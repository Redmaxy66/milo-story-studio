    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst concepts = items.map(item => item.json);\n\nconst canonFiles = [\n  'MILO_CHARACTER.md',\n  'MILO_BACKSTORY.md',\n  'VOICE_GUIDE.md',\n  'VISUAL_REFERENCE.md',\n  'PERSONALITY_RULES.md',\n];\n\nconst valid =\n  concepts.length === 3 &&\n  concepts.every((c) => {\n    const storyId = c.storyId ?? '';\n    const conceptId = c.conceptId ?? '';\n\n    return (\n      /^MILO-[0-9]{3}$/.test(storyId) &&\n      /^MILO-[0-9]{3}-C0[1-3]$/.test(conceptId) &&\n      conceptId.startsWith(storyId + '-') &&\n      ['title', 'premise', 'centralProblem', 'emotionalArc', 'lesson', 'setting'].every(\n        field => typeof c[field] === 'string' && c[field].trim().length > 0\n      ) &&\n      Array.isArray(c.supportingCharacters) &&\n      Array.isArray(c.canonReferences) &&\n      c.canonReferences.length >= 1 &&\n      c.canonReferences.every(file => canonFiles.includes(file)) &&\n      c.approvalStatus === 'PENDING_REVIEW'\n    );\n  });\n\nreturn [\n  {\n    json: {\n      conceptBatchValid: valid,\n      conceptCount: concepts.length,\n      concepts,\n    },\n  },\n];"
      },
