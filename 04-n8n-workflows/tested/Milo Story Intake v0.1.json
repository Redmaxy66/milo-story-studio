    {
      "parameters": {
        "jsCode": "// Read every existing row returned by Google Sheets.\nconst rows = $input.all();\n\n// Extract valid numbers from IDs such as MILO-001 and MILO-027.\nconst existingNumbers = rows\n  .map(item => item.json.storyId)\n  .filter(id => typeof id === 'string' && /^MILO-\\d+$/.test(id))\n  .map(id => Number(id.split('-')[1]));\n\n// If no IDs exist, begin at 1. Otherwise add 1 to the highest number.\nconst nextNumber =\n  existingNumbers.length > 0\n    ? Math.max(...existingNumbers) + 1\n    : 1;\n\n// Format the number with three digits.\nconst storyId = `MILO-${String(nextNumber).padStart(3, '0')}`;\n\n// Retrieve the clean story data created earlier.\nconst storyData = $('Standardise Story Data').first().json;\n\n// Return one complete story record.\nreturn [\n  {\n    json: {\n      storyId,\n      ...storyData,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
