{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milo-story-studio.local/contracts/m8-controlled-values-v1.json",
  "version": "m8-controlled-values-v1.0",
  "recordTypes": [
    "ProductionIntentArtifact",
    "ProductionAssetRequest",
    "GenerationAttempt",
    "GeneratedAsset",
    "AssetReference",
    "RevisionRequest",
    "AssetApproval",
    "CostRecord",
    "EpisodeAssembly",
    "AssemblyApproval",
    "PublishingPackage",
    "PublishingApproval"
  ],
  "artifactTypes": ["DIRECTOR_BRIEF", "STORYBOARD", "ANIMATION_MANIFEST", "PROMPT_BUNDLE", "VISUAL_REFERENCE_PACK"],
  "requestTypes": ["STILL", "SHOT_PLAN", "VIDEO", "VOICE", "MUSIC", "SFX", "LIP_SYNC", "CAPTION", "OTHER"],
  "referenceClassifications": ["CANON_FACT_DERIVATION", "APPROVED_PRODUCTION_CHOICE", "APPROVED_NON_CANON_REFERENCE"],
  "canonicalCapabilities": ["SHOT_PLAN", "TEXT_TO_IMAGE", "REFERENCE_IMAGE", "IMAGE_TO_VIDEO", "ELEMENT_TO_VIDEO", "SELECTIVE_REVISION", "VOICE_GENERATION", "MUSIC_GENERATION", "SFX_GENERATION", "LIP_SYNC", "CAPTION_GENERATION", "OTHER"],
