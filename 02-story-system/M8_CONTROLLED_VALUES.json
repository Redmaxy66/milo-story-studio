  "approvalDecisions": ["APPROVED", "REJECTED", "CHANGES_REQUESTED", "VOIDED"],
  "costEventTypes": ["ESTIMATE", "RESERVATION", "ACTUAL", "REFUND", "ADJUSTMENT"],
  "costUnits": ["PROVIDER_CREDIT", "USD"],
